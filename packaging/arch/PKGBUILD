# Maintainer: txj <treexxjay@gmail.com>
pkgname=hyperx-haste2
pkgver=0.1.0
pkgrel=1
pkgdesc='Linux driver and settings GUI for the HyperX Pulsefire Haste 2 Pro 4K mouse'
arch=('any')
url='https://github.com/CHANGEME/hyperx-haste2'
license=('MIT')
depends=('python' 'python-pyqt6' 'python-evdev')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
# Local builds: run ./make-tarball.sh first. For the AUR, replace with the release tarball:
#   source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 udev/70-hyperx-pulsefire-haste2-pro.rules -t "$pkgdir/usr/lib/udev/rules.d/"
  install -Dm644 packaging/hyperx-haste2.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 packaging/hyperx-haste2.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
